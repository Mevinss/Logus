{
  "name": "logus",
  "version": "1.0.0",
  "description": "Русскоязычная платформа для онлайн-занятий",
  "scripts": {
    "test": "playwright test --config tests/playwright.config.ts",
    "build": "next build",
    "start": "node --env-file-if-exists=.env.local scripts/start.mjs",
    "dev": "node --env-file-if-exists=.env.local scripts/start.mjs --dev",
    "db:backup": "node --env-file-if-exists=.env.local scripts/backup.mjs",
    "db:setup": "node --env-file-if-exists=.env.local scripts/setup.mjs",
    "test:api": "node scripts/test-api.mjs",
    "demo": "node --env-file-if-exists=.env.local scripts/example.mjs",
    "test:cloud": "node --test scripts/test-cloud.mjs",
    "test:authoring": "node --test tests/authoring.test.mjs"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@vercel/blob": "^2.9.0",
    "mammoth": "^1.13.0",
    "next": "^16.4.6",
    "pdfjs-dist": "^6.5.438",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fflate": "^0.8.3",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "zod": "4.6.6"
  }
}
